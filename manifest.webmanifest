      "icons": [
        {
          "src": "assets/brand/app/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Seller dashboard",
      "url": "vendor/dashboard.html",
      "icons": [
        {
          "src": "assets/brand/app/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Seller orders",
      "url": "vendor/orders.html",
      "icons": [
        {
