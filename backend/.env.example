# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API. On shared
# hosting the frontend usually lives on the same domain, but keep this
# explicit rather than wildcarding "*" — see BACKEND_GUIDE.md §6.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database ---
# cPanel's MySQL Database Wizard gives you DB_HOST/DB_NAME/DB_USER on
# shared hosting; a free host like Clever Cloud/Aiven/db4free.net gives
# you the same five values for testing on Render — see backend/README.md's
# "Deploying to Render" section. Most free/managed MySQL hosts require
# DB_SSL=true (shared-hosting localhost MySQL does not, leave it unset there).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yourcpaneluser_vetra
DB_USER=yourcpaneluser_vetra
DB_PASSWORD=
DB_SSL=false
# Max simultaneous connections this app's pool will open. Must be at or
# below whatever your database plan's own connection cap is (shared/managed
# hosts — Clever Cloud, and Namecheap's cPanel MySQL once this moves there —
# enforce a per-account limit separate from the server's overall capacity).
# Check the new plan's actual limit before changing this. Defaults to 5,
# matching the current Clever Cloud test database's cap.
DB_CONNECTION_LIMIT=5

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Encryption (vendor payout account number at rest — src/utils/encryption.js) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Google Sign-In (customer/vendor "Continue with Google") ---
# Create at console.cloud.google.com — APIs & Services > Credentials >
# Create Credentials > OAuth client ID (Web application). Only the
# Client ID is needed (never the Client Secret) — ID-token verification
# doesn't require it. Authorized JavaScript origins must include
# wherever the frontend is actually served from.
GOOGLE_CLIENT_ID=

# --- File uploads (Cloudinary — see BACKEND_GUIDE.md §7 step 8) ---
# Free tier, no card required: sign up at cloudinary.com, its Dashboard
# home page shows these three values directly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI shopping assistant (Anthropic Claude) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5-20251001

# --- Email delivery (Resend — see src/utils/mailer.js) ---
# Free tier, no card required: sign up at resend.com, create an API key.
# Without RESEND_API_KEY set, emails are logged to the server console
# instead of sent — every call site keeps working either way.
RESEND_API_KEY=
# Must be an address on a domain verified in the Resend dashboard
# (resend.com/domains). Leave unset to use Resend's own sandbox sender,
# which only delivers to the account's own verified email — fine for a
# smoke test, not for real end users.
EMAIL_FROM=

# Base URL of the deployed frontend, used to build links inside emails
# (password reset). Defaults to the current Vercel deployment.
FRONTEND_URL=https://vetra-vercel.vercel.app
