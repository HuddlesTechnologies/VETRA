# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API. On shared
# hosting the frontend usually lives on the same domain, but keep this
# explicit rather than wildcarding "*" — see BACKEND_GUIDE.md §6.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database (cPanel MySQL Database Wizard gives you these) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yourcpaneluser_vetra
DB_USER=yourcpaneluser_vetra
DB_PASSWORD=

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI shopping assistant (Anthropic Claude) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5-20251001
