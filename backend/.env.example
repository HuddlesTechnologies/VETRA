# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
# On cPanel, Passenger assigns the port itself, leave PORT unset there.
PORT=4000
# Comma-separated list of origins allowed to call this API. On shared
# hosting the frontend usually lives on the same domain, but keep this
# explicit rather than wildcarding "*" — see BACKEND_GUIDE.md §6.
CORS_ORIGINS=https://vetrahq.org,https://www.vetrahq.org

# --- Database ---
# cPanel's MySQL Database Wizard gives you DB_HOST/DB_NAME/DB_USER on
# shared hosting; a free host like Clever Cloud/Aiven/db4free.net gives
# you the same five values for testing on Render — see backend/README.md's
# "Deploying to Render" section. Most free/managed MySQL hosts require
# DB_SSL=true (shared-hosting localhost MySQL does not, leave it unset there).
# On cPanel: DB_HOST=localhost and DB_SSL=false. cPanel prefixes the
# database and user names with your account username.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yourcpaneluser_vetra
DB_USER=yourcpaneluser_vetra
DB_PASSWORD=
DB_SSL=false
# Max simultaneous connections this app's pool will open. Must be at or
# below whatever your database plan's own connection cap is (shared/managed
# hosts enforce a per-account limit separate from the server's overall
# capacity). Defaults to 20, matching Namecheap's standard shared hosting
# plan's maxEntryProc (concurrent-processes) limit — a cPanel/CloudLinux
# cap on the whole account, not just MySQL, so the Node app itself shares
# that same 20 with its DB connections. The current Clever Cloud test
# database caps this account at only 5 — Render's live deployment
# overrides this default via render.yaml, so this file's default only
# applies once the database itself is on Namecheap.
# On cPanel, 10 is a safer starting point than 20: the account's
# process cap is shared with the Node app itself and the cron job.
DB_CONNECTION_LIMIT=20

# Max requests allowed to wait for a free pooled connection before mysql2
# starts rejecting new ones outright, instead of queuing forever (its own
# default is 0 = unbounded). Rejecting fast under a real burst is a
# clean, visible error; an unbounded queue just looks like hung requests.
DB_QUEUE_LIMIT=50

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Server-side inactivity window; JWT_EXPIRES_IN remains the absolute maximum.
SESSION_IDLE_TIMEOUT_MINUTES=30
# Notify vendors when stock reaches this quantity or lower.
LOW_STOCK_THRESHOLD=5

# --- Encryption (vendor payout account number at rest — src/utils/encryption.js) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Google Sign-In (customer/vendor "Continue with Google") ---
# Create at console.cloud.google.com — APIs & Services > Credentials >
# Create Credentials > OAuth client ID (Web application). Only the
# Client ID is needed (never the Client Secret) — ID-token verification
# doesn't require it. Authorized JavaScript origins must include
# wherever the frontend is actually served from.
GOOGLE_CLIENT_ID=

# --- File uploads (stored on this server, src/utils/storage.js) ---
# The defaults are right for the cPanel account, leave these unset there.
# Public photos/video go into the website's folder and Apache serves them:
# PUBLIC_UPLOAD_DIR=/home/<cpanel-user>/vetrahq.org/uploads
# PUBLIC_UPLOAD_URL=https://vetrahq.org/uploads
# KYC documents go outside the website, served only via signed links:
# PRIVATE_UPLOAD_DIR=/home/<cpanel-user>/vetra-private-uploads
# API_PUBLIC_URL=https://api.vetrahq.org
# For local development, point uploads at the API itself, e.g.
# PUBLIC_UPLOAD_DIR=./uploads  PUBLIC_UPLOAD_URL=http://localhost:4000/uploads
# PRIVATE_UPLOAD_DIR=./private-uploads  API_PUBLIC_URL=http://localhost:4000

# --- AI shopping assistant (Anthropic Claude) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5-20251001

# --- Bank verification (Paystack Miscellaneous API — vendor payout account
# bank list + NUBAN-to-account-name resolution, src/utils/paystack.js) ---
# Free to use — sign up at paystack.com, dashboard.paystack.com/#/settings/developer
# has the secret key. The TEST key (sk_test_...) works for both the bank
# list and resolve calls with no live money involved.
PAYSTACK_SECRET_KEY=

# --- Identity verification (IDCheck.ng, vendor KYC, src/utils/idcheck.js) ---
# Create an application in the IDCheck.ng dashboard and mint an API key.
# sk_test_... keys return synthetic sandbox data (results are labelled
# "sandbox" in the admin console); switch to sk_live_... once IDCheck has
# approved go-live. Both use the same base URL. Keep the key server-side;
# it must never be added to frontend JavaScript.
IDCHECK_API_KEY=
# IDCHECK_BASE_URL=https://api.idcheck.ng

# --- Email delivery (SMTP via cPanel mail, see src/utils/mailer.js) ---
# Create the mailbox in cPanel > Email Accounts (e.g. noreply@vetrahq.org);
# its password goes in SMTP_PASS. Port 465 is implicit TLS (SMTP_SECURE
# true); use 587 with SMTP_SECURE=false if 465 is blocked. SMTP_HOST is
# the server's own hostname (cPanel sidebar), NOT mail.vetrahq.org: the
# mail server presents Namecheap's shared *.web-hosting.com certificate,
# so mail.vetrahq.org fails TLS and every email silently fails to send.
# Without SMTP_HOST set, emails are logged to the server console
# instead of sent, and every action that sends one still completes.
SMTP_HOST=premium176-2.web-hosting.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@vetrahq.org
SMTP_PASS=
# Must be the SMTP_USER mailbox (or an alias of it), or the server and
# receiving spam filters reject it. Defaults to "VETRA <SMTP_USER>".
EMAIL_FROM="VETRA <noreply@vetrahq.org>"

# Base URL of the deployed frontend, used to build links inside emails
# (password reset, rider invites, "track it live"). Defaults to
# https://vetrahq.org, where cPanel serves the site.
FRONTEND_URL=https://vetrahq.org

# --- Delivery sweep (src/utils/delivery.js runDeliveryCron) ---
# On cPanel, schedule `node scripts/delivery-cron.js` as a cron job and
# leave this unset. It only enables POST /api/delivery/cron, for hosts
# that can't run a cron command and need an external pinger instead.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
